        "validaciones": {}, 
        "resumen": []
    }

    tipo_cambio = meta.get("tipo_cambio", "DESCONOCIDO").upper()
    es_despliegue = "DESPLIEGUE" in tipo_cambio

    faltantes = [k for k, v in {"TA": ta, "AID": aid, "UDZ": udz}.items() if not v]
    if faltantes:
        if es_despliegue:
            # DESPLIEGUE requiere los 3 archivos sin excepci???n
